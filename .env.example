ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Set true only when Sentinel is served over HTTPS.
COOKIE_SECURE=false
# Read-only Kubernetes service-account credentials.
KUBERNETES_API_URL=https://kubernetes.default.svc
KUBERNETES_TOKEN=
# Optional CA bundle for an external Kubernetes API.
KUBERNETES_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt

# Alert routing. TLS/DNS/domain checks can be enabled independently.
ALERT_INTERVAL_MINUTES=15
ALERT_TLS_ENABLED=true
ALERT_DNS_ENABLED=true
ALERT_DOMAIN_ENABLED=true

# SMTP section. TLS mode is starttls (587), implicit (465), or none.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_TLS_SERVER_NAME=smtp.example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=sentinel@example.com
SMTP_TO=ops@example.com

# Multi-cluster section. Use a Kubernetes Secret for tokens in production.
# Each entry needs node list access and metrics.k8s.io node access.
KUBERNETES_CLUSTERS_JSON=[]

# Provide all accounts when using more than the fallback admin account.
# Roles: admin, operator, viewer.
SENTINEL_USERS_JSON=[{"email":"admin@example.com","password":"replace-admin-password","role":"admin"},{"email":"viewer@example.com","password":"replace-viewer-password","role":"viewer"}]
